# Local development defaults to ./vion.db. On a VM, use a persistent path.
# DATABASE_PATH=/home/ubuntu/data/vion.db
# Optional Turso setup: DATABASE_URL takes precedence over DATABASE_PATH.
# DATABASE_URL=libsql://your-database.turso.io
# DATABASE_AUTH_TOKEN=

# --- Auth (required in production) --------------------------------------------

# Secret used to sign session cookies. Generate with: openssl rand -base64 32
# SESSION_SECRET=

# Login accounts, comma-separated entries of email:Display Name:passwordHash.
# Add a user securely with: npm run auth:add -- user@example.com "Display Name"
# The command prompts for the password without echoing it and updates .env.
# Password hashes can also be generated with npm run auth:hash.
# (Names may contain anything except a comma. All configured users currently
# have the same permissions; role-based access control is not implemented.)
# AUTH_USERS=anish@example.com:Anish:salt.hash,other@example.com:Other:salt.hash

# Set to 0 only if serving production over plain HTTP (no HTTPS yet) — secure
# cookies are never sent over http:// and login would otherwise fail.
# COOKIE_SECURE=0

# --- PDF generation ------------------------------------------------------------

# Where Puppeteer fetches the printable page. Set this on servers so PDF
# rendering goes through localhost instead of the public origin.
# PDF_BASE_URL=http://127.0.0.1:3000

# System Chromium for Puppeteer. Required on Linux ARM (e.g. Oracle Ampere VMs)
# where Puppeteer has no downloadable Chromium build.
# PUPPETEER_EXECUTABLE_PATH=/snap/bin/chromium
